@model Supermercado.Clientes.Models.ClienteViewModel
@{
    ViewData["Title"] = "Nuevo cliente";
}

<h1 class="h3 mb-3">Nuevo cliente</h1>

<form asp-action="Create" method="post" style="max-width: 720px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
