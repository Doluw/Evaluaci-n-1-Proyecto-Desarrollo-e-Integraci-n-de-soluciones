@model EditarPrecioViewModel
@{
    ViewData["Title"] = "Cambiar precio";
}

<a asp-action="Index" class="btn btn-link px-0 mb-2">&larr; Volver</a>

<div class="card" style="max-width: 480px">
    <div class="card-body">
        <h1 class="h4">@Model.Nombre</h1>
        <p class="text-muted">Precio por @Model.UnidadMedida, en pesos chilenos.</p>

        <form asp-action="EditarPrecio" asp-route-id="@Model.Id" method="post">
            <label for="Precio" class="form-label">Precio unitario</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input id="Precio" name="Precio" type="number" min="1" step="1" class="form-control"
                       value="@(Model.Precio?.ToString("0", System.Globalization.CultureInfo.InvariantCulture))" autofocus />
            </div>
            <span asp-validation-for="Precio" class="text-danger small"></span>
            <p class="form-text">Cambiar el precio no modifica las ventas ya registradas.</p>
            <button type="submit" class="btn btn-success">Guardar</button>
        </form>
    </div>
</div>