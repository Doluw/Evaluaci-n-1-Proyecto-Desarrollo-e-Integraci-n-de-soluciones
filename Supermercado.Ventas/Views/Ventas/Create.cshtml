@model NuevaVentaViewModel
@{
    ViewData["Title"] = "Nueva venta";
    var cl = new System.Globalization.CultureInfo("es-CL");
    var lineasIniciales = Model.Input.Lineas.Where(l => l.ProductoId > 0).ToList();
}

<h1 class="h3 mb-3">Nueva venta</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="Create" method="post" id="form-venta">
    <div class="row g-3">

        <!-- Columna izquierda: caja, cliente y totales -->
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-body">
                    <label asp-for="Input.Caja" class="form-label fw-semibold">Caja</label>
                    <select asp-for="Input.Caja" class="form-select mb-3" required>
                        <option value="">Seleccione...</option>
                        @for (int i = 1; i <= 10; i++)
                        {
                            <option value="@i">Caja @i</option>
                        }
                    </select>

                    <label asp-for="Input.RutCliente" class="form-label fw-semibold">
                        RUT cliente <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <div class="input-group">
                        <input asp-for="Input.RutCliente" class="form-control" placeholder="12345678-5" autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" id="btn-rut">Verificar</button>
                    </div>
                    <div id="info-cliente" class="form-text mt-2"></div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span>Subtotal</span><span id="t-subtotal">$0</span>
                    </div>
                    <div class="d-flex justify-content-between text-success">
                        <span id="t-desc-label">Descuento</span><span id="t-descuento">$0</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span>Total</span><span id="t-total" class="fs-3 fw-bold">$0</span>
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100 mt-3">Registrar venta</button>
                </div>
            </div>
        </div>

        <!-- Columna derecha: productos -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body border-bottom">
                    <div class="row g-2">
                        <div class="col-md-7">
                            <select id="sel-producto" class="form-select">
                                <option value="">Producto (Sala de Ventas)...</option>
                                @foreach (var p in Model.Productos)
                                {
                                    <option value="@p.Id">@p.Nombre - @p.Precio.ToString("C0", cl) (stock @p.Stock)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input id="inp-cantidad" type="number" min="1" step="1" value="1" class="form-control" />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="button" id="btn-agregar" class="btn btn-primary">Agregar</button>
                        </div>
                    </div>
                    @if (Model.Productos.Count == 0)
                    {
                        <div class="text-muted small mt-2">
                            No hay productos con precio y stock en Sala de Ventas.
                            Asigne precios en <a asp-controller="Productos" asp-action="Index">Precios</a>.
                        </div>
                    }
                </div>

                <table class="table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-end" style="width: 130px">Cantidad</th>
                            <th class="text-end">Precio unit.</th>
                            <th class="text-end">Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="lineas">
                        <tr id="sin-lineas">
                            <td colspan="5" class="text-center text-muted py-4">Agregue productos a la venta.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
(() => {
    const listaProductos = @Json.Serialize(Model.Productos);
    const lineasIniciales = @Json.Serialize(lineasIniciales);

    const productos = new Map(listaProductos.map(p => [p.id, p]));
    let porcentajeDescuento = 0;

    const $ = id => document.getElementById(id);
    const tbody = $('lineas');
    const clp = n => new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(Math.round(n));
    const esc = t => String(t).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Agrega un producto a la tabla (si ya está, suma la cantidad).
    function agregar(id, cantidad) {
        const p = productos.get(id);
        if (!p || !(cantidad > 0)) return;

        const existente = tbody.querySelector(`tr[data-id="${id}"]`);
        if (existente) {
            const input = existente.querySelector('.cant');
            input.value = +input.value + cantidad;
        } else {
            const tr = document.createElement('tr');
            tr.dataset.id = id;
            tr.innerHTML = `
                <td>${esc(p.nombre)}<br><small class="text-muted">stock ${p.stock}</small>
                    <input type="hidden" class="pid" value="${id}"></td>
                <td><input type="number" class="form-control form-control-sm text-end cant" min="1" step="1" value="${cantidad}"></td>
                <td class="text-end">${clp(p.precio)}</td>
                <td class="text-end sub"></td>
                <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger quitar">&times;</button></td>`;
            tbody.appendChild(tr);
        }
        recalcular();
    }

    // Renumera los campos (Input.Lineas[0], [1]...) y recalcula los totales.
    function recalcular() {
        const filas = [...tbody.querySelectorAll('tr[data-id]')];
        $('sin-lineas').style.display = filas.length ? 'none' : '';

        let subtotal = 0;
        filas.forEach((tr, i) => {
            const p = productos.get(+tr.dataset.id);
            const cant = tr.querySelector('.cant');
            tr.querySelector('.pid').name = `Input.Lineas[${i}].ProductoId`;
            cant.name = `Input.Lineas[${i}].Cantidad`;

            const cantidad = +cant.value || 0;
            const sub = p.precio * cantidad;
            tr.querySelector('.sub').textContent = clp(sub);
            cant.classList.toggle('is-invalid', cantidad < 1 || cantidad > p.stock);
            subtotal += sub;
        });

        const descuento = Math.round(subtotal * porcentajeDescuento / 100);
        $('t-subtotal').textContent = clp(subtotal);
        $('t-desc-label').textContent = porcentajeDescuento ? `Descuento cliente (${porcentajeDescuento}%)` : 'Descuento';
        $('t-descuento').textContent = descuento ? '- ' + clp(descuento) : clp(0);
        $('t-total').textContent = clp(subtotal - descuento);
    }

    // Consulta al servidor si el RUT es válido y si el cliente está registrado.
    async function verificarRut() {
        const rut = $('Input_RutCliente').value.trim();
        const info = $('info-cliente');
        porcentajeDescuento = 0;

        if (!rut) {
            info.textContent = '';
            recalcular();
            return;
        }

        const r = await fetch(`@Url.Action("VerificarRut")?rut=${encodeURIComponent(rut)}`).then(x => x.json());
        if (!r.valido) {
            info.innerHTML = '<span class="text-danger">RUT no válido.</span>';
        } else if (r.registrado) {
            porcentajeDescuento = r.descuento;
            info.innerHTML = `<span class="text-success">Cliente registrado: ${r.descuento}% de descuento.</span>`;
        } else {
            info.innerHTML = '<span class="text-muted">Cliente no registrado: la venta se hará sin descuento.</span>';
        }
        recalcular();
    }

    $('btn-agregar').addEventListener('click', () => {
        agregar(+$('sel-producto').value, +$('inp-cantidad').value);
        $('sel-producto').value = '';
        $('inp-cantidad').value = 1;
    });

    tbody.addEventListener('input', recalcular);
    tbody.addEventListener('click', e => {
        if (e.target.classList.contains('quitar')) {
            e.target.closest('tr').remove();
            recalcular();
        }
    });

    $('btn-rut').addEventListener('click', verificarRut);
    $('Input_RutCliente').addEventListener('change', verificarRut);

    $('form-venta').addEventListener('submit', e => {
        if (!tbody.querySelector('tr[data-id]')) {
            e.preventDefault();
            $('sin-lineas').querySelector('td').innerHTML = '<span class="text-danger">Agregue al menos un producto.</span>';
        }
    });

    // Si el formulario volvió con errores, se recargan los productos que ya estaban.
    lineasIniciales.forEach(l => agregar(l.productoId, l.cantidad));
    if ($('Input_RutCliente').value) verificarRut();
    recalcular();
})();
</script>
}