@model AjustarInventarioViewModel
@{
    ViewData["Title"] = "Ajustar stock";
}

<div class="mx-auto" style="max-width: 720px;">
    <a class="btn btn-link px-0 mb-2" asp-controller="Bodegas" asp-action="Index">&larr; Volver a bodegas</a>
    <div class="card card-body">
        <h1 class="h3">Ajustar stock</h1>
        <p class="text-muted">Agrega nuevas unidades o descuenta existencias de una bodega.</p>
        <form asp-action="Ajustar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <div class="mb-3">
                <label asp-for="BodegaId" class="form-label"></label>
                <select asp-for="BodegaId" asp-items="Model.Bodegas" class="form-select"><option value="0">Seleccionar bodega</option></select>
                <span asp-validation-for="BodegaId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProductoId" class="form-label"></label>
                <select asp-for="ProductoId" asp-items="Model.Productos" class="form-select"><option value="0">Seleccionar producto</option></select>
                <span asp-validation-for="ProductoId" class="text-danger"></span>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label asp-for="Operacion" class="form-label">Operación</label>
                    <select asp-for="Operacion" class="form-select"><option value="agregar">Agregar</option><option value="quitar">Quitar</option></select>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Cantidad" class="form-label"></label>
                    <input asp-for="Cantidad" class="form-control" min="1" />
                    <span asp-validation-for="Cantidad" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <a class="btn btn-link" asp-controller="Bodegas" asp-action="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit">Guardar ajuste</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
