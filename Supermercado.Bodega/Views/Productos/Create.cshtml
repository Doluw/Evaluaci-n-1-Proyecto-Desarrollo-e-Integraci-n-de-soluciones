@model CrearProductoViewModel
@{
    ViewData["Title"] = "Nuevo producto";
}

<div class="mx-auto" style="max-width: 720px;">
    <a class="btn btn-link px-0 mb-2" asp-controller="Bodegas" asp-action="Index">&larr; Volver a bodegas</a>
    <div class="card card-body">
        <h1 class="h3">Crear producto</h1>
        <p class="text-muted">El identificador del producto se generará automáticamente.</p>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Arroz grado 2" autocomplete="off" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="UnidadMedida" class="form-label"></label>
                <input asp-for="UnidadMedida" class="form-control" placeholder="Ej: Unidad, kg, litro" autocomplete="off" />
                <span asp-validation-for="UnidadMedida" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <a class="btn btn-link" asp-controller="Bodegas" asp-action="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit">Crear producto</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
