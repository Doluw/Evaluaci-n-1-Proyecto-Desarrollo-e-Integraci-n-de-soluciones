@model IReadOnlyList<BodegaResumenViewModel>
@{
    ViewData["Title"] = "Bodegas";
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Control de inventario</span>
        <h1>Bodegas del supermercado</h1>
        <p>Consulta las existencias y administra el stock de cada ubicación.</p>
    </div>
    <div class="heading-actions">
        <a class="btn btn-outline-primary" asp-controller="Inventario" asp-action="Importar">Importar JSON</a>
        <a class="btn btn-primary" asp-action="Create">Nueva bodega</a>
    </div>
</section>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="quick-actions">
    <a asp-controller="Productos" asp-action="Create">
        <span class="quick-icon">＋</span>
        <span><strong>Crear producto</strong><small>Registra un producto nuevo</small></span>
    </a>
    <a asp-controller="Inventario" asp-action="Ajustar">
        <span class="quick-icon">±</span>
        <span><strong>Ajustar stock</strong><small>Agrega o quita cantidades</small></span>
    </a>
    <a asp-controller="Inventario" asp-action="Mover">
        <span class="quick-icon">⇄</span>
        <span><strong>Mover stock</strong><small>Transfiere entre bodegas</small></span>
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>Aún no existen bodegas</h2>
        <p>Crea la primera ubicación para comenzar a registrar inventario.</p>
        <a class="btn btn-primary" asp-action="Create">Crear bodega</a>
    </div>
}
else
{
    <div class="warehouse-grid">
        @foreach (var bodega in Model)
        {
            <article class="warehouse-card @(bodega.Codigo == "VENTAS" ? "sales-room" : "")">
                <div class="warehouse-card__top">
                    <span class="warehouse-code">@bodega.Codigo</span>
                    @if (bodega.Codigo == "VENTAS")
                    {
                        <span class="status-badge">Sala de Ventas</span>
                    }
                </div>
                <h2>@bodega.Nombre</h2>
                <div class="warehouse-stats">
                    <div><strong>@bodega.ProductosDistintos</strong><span>productos</span></div>
                    <div><strong>@bodega.UnidadesTotales</strong><span>unidades</span></div>
                </div>
                <a class="card-link" asp-action="Details" asp-route-id="@bodega.Id">Ver inventario <span>→</span></a>
            </article>
        }
    </div>
}
