@model IReadOnlyList<BodegaResumenViewModel>
@{
    ViewData["Title"] = "Bodegas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Bodegas</h1>
        <p class="text-muted mb-0">Existencias disponibles en cada ubicación del supermercado.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Inventario" asp-action="Importar">Importar JSON</a>
        <a class="btn btn-primary" asp-action="Create">Nueva bodega</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card card-body mb-3">
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-controller="Productos" asp-action="Create">Nuevo producto</a>
        <a class="btn btn-outline-primary" asp-controller="Inventario" asp-action="Ajustar">Ajustar stock</a>
        <a class="btn btn-outline-primary" asp-controller="Inventario" asp-action="Mover">Mover stock</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">
        No hay bodegas para mostrar.
        <a asp-action="Create" class="alert-link">Crear la primera bodega</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th class="text-end">Productos</th>
                    <th class="text-end">Unidades</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var bodega in Model)
            {
                <tr>
                    <td><code>@bodega.Codigo</code></td>
                    <td>
                        @bodega.Nombre
                        @if (bodega.Codigo == "VENTAS")
                        {
                            <span class="badge bg-success ms-1">Sala de Ventas</span>
                        }
                    </td>
                    <td class="text-end">@bodega.ProductosDistintos</td>
                    <td class="text-end">@bodega.UnidadesTotales</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@bodega.Id">Ver inventario</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
