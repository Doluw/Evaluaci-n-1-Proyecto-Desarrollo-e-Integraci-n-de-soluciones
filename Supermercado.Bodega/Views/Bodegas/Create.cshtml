@model CrearBodegaViewModel
@{
    ViewData["Title"] = "Nueva bodega";
}

<div class="form-page">
    <a class="back-link" asp-action="Index">← Volver a bodegas</a>
    <div class="form-card">
        <span class="eyebrow">Nueva ubicación</span>
        <h1>Crear bodega</h1>
        <p>Registra el código único y el nombre con que se identificará.</p>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <div class="mb-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" placeholder="Ej: CENTRAL" autocomplete="off" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
                <div class="form-text">Se guardará automáticamente en mayúsculas.</div>
            </div>
            <div class="mb-4">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Bodega Central" autocomplete="off" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-actions">
                <a class="btn btn-light" asp-action="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit">Crear bodega</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
