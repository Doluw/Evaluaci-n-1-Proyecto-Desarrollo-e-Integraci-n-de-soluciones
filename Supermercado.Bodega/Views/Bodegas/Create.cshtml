@model CrearBodegaViewModel
@{
    ViewData["Title"] = "Nueva bodega";
}

<div class="mx-auto" style="max-width: 720px;">
    <a class="btn btn-link px-0 mb-2" asp-action="Index">&larr; Volver a bodegas</a>
    <div class="card card-body">
        <h1 class="h3">Crear bodega</h1>
        <p class="text-muted">Registra el código único y el nombre con que se identificará.</p>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <div class="mb-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" placeholder="Ej: CENTRAL" autocomplete="off" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
                <div class="form-text">Se guardará automáticamente en mayúsculas.</div>
            </div>
            <div class="mb-4">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Bodega Central" autocomplete="off" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <a class="btn btn-link" asp-action="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit">Crear bodega</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
